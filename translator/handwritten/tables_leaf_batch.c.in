/* IMGUI_C89_FUNCTION_BEGIN table_get_column_count */
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
return table ? table->ColumnsCount : 0;
/* IMGUI_C89_FUNCTION_END table_get_column_count */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_name_current */
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
if (!table)
    return 0;
if (column_n < 0)
    column_n = table->CurrentColumn;
return @TABLE_GET_COLUMN_NAME@(table, column_n);
/* IMGUI_C89_FUNCTION_END table_get_column_name_current */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_name_table */
const ImGuiTableColumn *column;
if (!table->IsLayoutLocked && column_n >= table->DeclColumnsCount)
    return "";
column = &table->Columns.Data[column_n];
return column->NameOffset == -1 ? "" : table->ColumnsNames.Buf.Data + column->NameOffset;
/* IMGUI_C89_FUNCTION_END table_get_column_name_table */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_flags */
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
if (!table)
    return @COLUMN_NONE@;
if (column_n < 0)
    column_n = table->CurrentColumn;
if (column_n == table->ColumnsCount)
    return table->HoveredColumnBody == column_n ? @COLUMN_HOVERED@ : @COLUMN_NONE@;
return table->Columns.Data[column_n].Flags;
/* IMGUI_C89_FUNCTION_END table_get_column_flags */

/* IMGUI_C89_FUNCTION_BEGIN table_get_cell_bg_rect */
const ImGuiTableColumn *column;
ImRect rect;
column = &table->Columns.Data[column_n];
rect.Min.x = column->MinX > table->WorkRect.Min.x ? column->MinX : table->WorkRect.Min.x;
rect.Min.y = table->RowPosY1;
rect.Max.x = column->MaxX < table->WorkRect.Max.x ? column->MaxX : table->WorkRect.Max.x;
rect.Max.y = table->RowPosY2;
return rect;
/* IMGUI_C89_FUNCTION_END table_get_cell_bg_rect */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_resize_id */
ImGuiTableInstanceData *instance;
instance = instance_no == 0 ? &table->InstanceDataFirst : &table->InstanceDataExtra.Data[instance_no - 1];
return instance->TableInstanceID + 1 + column_n;
/* IMGUI_C89_FUNCTION_END table_get_column_resize_id */

/* IMGUI_C89_FUNCTION_BEGIN table_get_hovered_column */
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
return table ? (int)table->HoveredColumnBody : -1;
/* IMGUI_C89_FUNCTION_END table_get_hovered_column */

/* IMGUI_C89_FUNCTION_BEGIN table_get_hovered_row */
ImGuiTable *table;
ImGuiTableInstanceData *instance;
table = imgui_c89_ctx->CurrentTable;
if (!table)
    return -1;
instance = table->InstanceCurrent == 0 ? &table->InstanceDataFirst : &table->InstanceDataExtra.Data[table->InstanceCurrent - 1];
return instance->HoveredRowLast;
/* IMGUI_C89_FUNCTION_END table_get_hovered_row */

/* IMGUI_C89_FUNCTION_BEGIN table_get_row_index */
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
return table ? table->CurrentRow : 0;
/* IMGUI_C89_FUNCTION_END table_get_row_index */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_index */
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
return table ? table->CurrentColumn : 0;
/* IMGUI_C89_FUNCTION_END table_get_column_index */

/* IMGUI_C89_FUNCTION_BEGIN table_calc_max_column_width */
const ImGuiTableColumn *column;
float max_width;
float min_distance;
column = &table->Columns.Data[column_n];
max_width = 3.402823466e38f;
min_distance = table->MinColumnWidth + 2.0f * table->CellPaddingX + table->CellSpacingX1 + table->CellSpacingX2;
if (table->Flags & @TABLE_SCROLL_X@)
{
    if (column->DisplayOrder < table->FreezeColumnsRequest)
        max_width = table->InnerClipRect.Max.x - (table->FreezeColumnsRequest - column->DisplayOrder) * min_distance - column->MinX - table->OuterPaddingX - table->CellPaddingX - table->CellSpacingX2;
}
else if (!(table->Flags & @TABLE_NO_KEEP_VISIBLE@))
    max_width = table->WorkRect.Max.x - (table->ColumnsEnabledCount - column->IndexWithinEnabledSet - 1) * min_distance - column->MinX - table->CellSpacingX2 - 2.0f * table->CellPaddingX - table->OuterPaddingX;
return max_width;
/* IMGUI_C89_FUNCTION_END table_calc_max_column_width */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_width_auto */
float body_width;
float header_width;
float width;
body_width = (column->ContentMaxXFrozen > column->ContentMaxXUnfrozen ? column->ContentMaxXFrozen : column->ContentMaxXUnfrozen) - column->WorkMinX;
header_width = column->ContentMaxXHeadersIdeal - column->WorkMinX;
width = body_width;
if (!(column->Flags & @COLUMN_NO_HEADER_WIDTH@) && header_width > width)
    width = header_width;
if ((column->Flags & @COLUMN_WIDTH_FIXED@) && column->InitStretchWeightOrWidth > 0.0f)
    if (!(table->Flags & @TABLE_RESIZABLE@) || (column->Flags & @COLUMN_NO_RESIZE@))
        width = column->InitStretchWeightOrWidth;
return width > table->MinColumnWidth ? width : table->MinColumnWidth;
/* IMGUI_C89_FUNCTION_END table_get_column_width_auto */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_avail_sort_direction */
return (ImGuiSortDirection)((column->SortDirectionsAvailList >> (n * 2)) & 3);
/* IMGUI_C89_FUNCTION_END table_get_column_avail_sort_direction */

/* IMGUI_C89_FUNCTION_BEGIN table_get_column_next_sort_direction */
int n;
if (column->SortOrder == -1)
    return @GET_AVAIL_DIRECTION@(column, 0);
for (n = 0; n < 3; n++)
    if (column->SortDirection == @GET_AVAIL_DIRECTION@(column, n))
        return @GET_AVAIL_DIRECTION@(column, (n + 1) % column->SortDirectionsAvailCount);
return @SORT_NONE@;
/* IMGUI_C89_FUNCTION_END table_get_column_next_sort_direction */

/* IMGUI_C89_FUNCTION_BEGIN table_get_header_row_height */
ImGuiTable *table;
float height;
int column_n;
table = imgui_c89_ctx->CurrentTable;
height = imgui_c89_ctx->FontSize;
for (column_n = 0; column_n < table->ColumnsCount; column_n++)
    if ((table->EnabledMaskByIndex[column_n >> 5] & ((ImU32)1 << (column_n & 31))) != 0 && !(table->Columns.Data[column_n].Flags & @COLUMN_NO_HEADER_LABEL@))
    {
        ImVec2 size;
        size = @CALC_TEXT_SIZE@(imgui_c89_ctx, @TABLE_GET_COLUMN_NAME@(table, column_n), 0, 0, 0.0f);
        if (size.y > height)
            height = size.y;
    }
return height + imgui_c89_ctx->Style.CellPadding.y * 2.0f;
/* IMGUI_C89_FUNCTION_END table_get_header_row_height */

/* IMGUI_C89_FUNCTION_BEGIN table_get_header_angled_max_label_width */
ImGuiTable *table;
float width;
int column_n;
table = imgui_c89_ctx->CurrentTable;
width = 0.0f;
for (column_n = 0; column_n < table->ColumnsCount; column_n++)
    if ((table->EnabledMaskByIndex[column_n >> 5] & ((ImU32)1 << (column_n & 31))) != 0 && (table->Columns.Data[column_n].Flags & @COLUMN_ANGLED_HEADER@))
    {
        ImVec2 size;
        size = @CALC_TEXT_SIZE@(imgui_c89_ctx, @TABLE_GET_COLUMN_NAME@(table, column_n), 0, 1, 0.0f);
        if (size.x > width)
            width = size.x;
    }
return width + imgui_c89_ctx->Style.CellPadding.y * 2.0f;
/* IMGUI_C89_FUNCTION_END table_get_header_angled_max_label_width */
