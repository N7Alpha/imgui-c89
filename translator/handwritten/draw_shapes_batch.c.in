int i;

if (id == @INVALID_RECT_ID@) return NULL;
i = @RECT_ID_INDEX@(id);
if (atlas->Builder == NULL) {
    @PACK_INIT@(imgui_c89_ctx, atlas);
}
if (i >= atlas->Builder->RectsIndex.Size) return NULL;
entry = &atlas->Builder->RectsIndex.Data[i];
if (entry->Generation != @RECT_ID_GENERATION@(id) || !entry->IsUsed) return NULL;
return &atlas->Builder->Rects.Data[entry->TargetIndex];
/* IMGUI_C89_FUNCTION_END atlas_pack_get_rect_safe */

/* IMGUI_C89_FUNCTION_BEGIN atlas_update_pointers */
ImFont *font;
ImFontConfig *src;
int i;

for (i = 0; i < atlas->Fonts.Size; i++) {
    atlas->Fonts.Data[i]->Sources.Size = 0;
}
for (i = 0; i < atlas->Sources.Size; i++) {
    src = &atlas->Sources.Data[i];
    font = src->DstFont;
    @FONT_SOURCE_PUSH@(imgui_c89_ctx, &font->Sources, &src);
}
/* IMGUI_C89_FUNCTION_END atlas_update_pointers */

/* IMGUI_C89_FUNCTION_BEGIN atlas_get_oversample */
float raster_size;

raster_size = baked->Size * baked->RasterizerDensity * src->RasterizerDensity;
*out_oversample_h = src->OversampleH != 0 ? src->OversampleH
    : (raster_size > 36.0f || src->PixelSnapH) ? 1 : 2;
*out_oversample_v = src->OversampleV != 0 ? src->OversampleV : 1;
/* IMGUI_C89_FUNCTION_END atlas_get_oversample */

/* IMGUI_C89_FUNCTION_BEGIN atlas_update_renderer_flag */
ImDrawListSharedData *data;
int i;

for (i = 0; i < atlas->DrawListSharedDatas.Size; i++) {
    data = atlas->DrawListSharedDatas.Data[i];
    if (data->Context != NULL) {
        atlas->RendererHasTextures = (data->Context->IO.BackendFlags &
                                      @RENDERER_HAS_TEXTURES@) != 0;
        break;
    }
}
/* IMGUI_C89_FUNCTION_END atlas_update_renderer_flag */

/* IMGUI_C89_FUNCTION_BEGIN calc_rounding_flags */
int left;
int right;
int top;
int bottom;

left = r_in->Min.x <= r_outer->Min.x + threshold;
right = r_in->Max.x >= r_outer->Max.x - threshold;
top = r_in->Min.y <= r_outer->Min.y + threshold;
bottom = r_in->Max.y >= r_outer->Max.y - threshold;
return @ROUND_CORNERS_NONE@
    | (top && left ? @ROUND_TOP_LEFT@ : 0)
    | (top && right ? @ROUND_TOP_RIGHT@ : 0)
    | (bottom && left ? @ROUND_BOTTOM_LEFT@ : 0)
    | (bottom && right ? @ROUND_BOTTOM_RIGHT@ : 0);
/* IMGUI_C89_FUNCTION_END calc_rounding_flags */

/* IMGUI_C89_FUNCTION_BEGIN render_bullet */
float size;

size = draw_list->_Data->FontSize;
@ADD_CIRCLE_FILLED@(imgui_c89_ctx, draw_list, &pos, size * 0.20f, col,
                    size < 22.0f ? 8 : size < 40.0f ? 12 : 0);
/* IMGUI_C89_FUNCTION_END render_bullet */

/* IMGUI_C89_FUNCTION_BEGIN draw_reset_frame */
ImDrawCmd command = {0};

if (self->_Splitter._Count > 1) {
    @SPLITTER_MERGE@(imgui_c89_ctx, &self->_Splitter, self);
}
self->CmdBuffer.Size = 0;
self->IdxBuffer.Size = 0;
self->VtxBuffer.Size = 0;
self->Flags = self->_Data->InitialFlags;
memset(&self->_CmdHeader, 0, sizeof(self->_CmdHeader));
self->_VtxCurrentIdx = 0;
self->_VtxWritePtr = NULL;
self->_IdxWritePtr = NULL;
self->_ClipRectStack.Size = 0;
self->_TextureStack.Size = 0;
self->_CallbacksDataBuf.Size = 0;
self->_Path.Size = 0;
@SPLITTER_CLEAR@(&self->_Splitter);
@CMD_PUSH@(imgui_c89_ctx, &self->CmdBuffer, &command);
self->_FringeScale = self->_Data->InitialFringeScale;
/* IMGUI_C89_FUNCTION_END draw_reset_frame */

/* IMGUI_C89_FUNCTION_BEGIN draw_data_deindex */
ImVector_ImDrawVert scratch = {0};
ImDrawList *list;
ImDrawVert *data;
int size;
int capacity;
int i;
int j;

self->TotalVtxCount = 0;
self->TotalIdxCount = 0;
for (i = 0; i < self->CmdLists.Size; i++) {
    list = self->CmdLists.Data[i];
    if (list->IdxBuffer.Size == 0) continue;
    @VTX_RESIZE@(imgui_c89_ctx, &scratch, list->IdxBuffer.Size);
    for (j = 0; j < list->IdxBuffer.Size; j++) {
        scratch.Data[j] = list->VtxBuffer.Data[list->IdxBuffer.Data[j]];
    }
    size = list->VtxBuffer.Size;
    capacity = list->VtxBuffer.Capacity;
    data = list->VtxBuffer.Data;
    list->VtxBuffer.Size = scratch.Size;
    list->VtxBuffer.Capacity = scratch.Capacity;
    list->VtxBuffer.Data = scratch.Data;
    scratch.Size = size;
    scratch.Capacity = capacity;
    scratch.Data = data;
    list->IdxBuffer.Size = 0;
    self->TotalVtxCount += list->VtxBuffer.Size;
}
if (scratch.Data != NULL) {
    @MEM_FREE@(imgui_c89_ctx, scratch.Data);
}
/* IMGUI_C89_FUNCTION_END draw_data_deindex */
