    @QUADRATIC_CASTELJAU@(imgui_c89_ctx, &self->_Path,
                          p1.x, p1.y, p2->x, p2->y, p3->x, p3->y,
                          self->_Data->CurveTessellationTol, 0);
} else {
    step = 1.0f / (float)num_segments;
    for (i = 1; i <= num_segments; i++) {
        point = @BEZIER_QUADRATIC_CALC@(&p1, p2, p3, step * i);
        @PATH_PUSH@(imgui_c89_ctx, &self->_Path, &point);
