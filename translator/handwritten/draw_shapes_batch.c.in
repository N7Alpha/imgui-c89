/* IMGUI_C89_FUNCTION_BEGIN draw_add_line */
ImVec2 points[2];

if ((col & @ALPHA_MASK@) == 0) return;
points[0].x = p1->x + 0.5f;
points[0].y = p1->y + 0.5f;
points[1].x = p2->x + 0.5f;
points[1].y = p2->y + 0.5f;
@ADD_POLYLINE@(imgui_c89_ctx, self, points, 2, col, thickness, 0);
/* IMGUI_C89_FUNCTION_END draw_add_line */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_line_h */
ImVec2 points[2];

if ((col & @ALPHA_MASK@) == 0) return;
points[0].x = min_x + 0.5f;
points[0].y = y + 0.5f;
points[1].x = max_x + 0.5f;
points[1].y = y + 0.5f;
@ADD_POLYLINE@(imgui_c89_ctx, self, points, 2, col, thickness, 0);
/* IMGUI_C89_FUNCTION_END draw_add_line_h */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_line_v */
ImVec2 points[2];

if ((col & @ALPHA_MASK@) == 0) return;
points[0].x = x + 0.5f;
points[0].y = min_y + 0.5f;
points[1].x = x + 0.5f;
points[1].y = max_y + 0.5f;
@ADD_POLYLINE@(imgui_c89_ctx, self, points, 2, col, thickness, 0);
/* IMGUI_C89_FUNCTION_END draw_add_line_v */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_rect_filled */
if ((col & @ALPHA_MASK@) == 0) return;
if (rounding < 0.5f ||
    (flags & @ROUND_CORNERS_MASK@) == @ROUND_CORNERS_NONE@) {
    @PRIM_RESERVE@(imgui_c89_ctx, self, 6, 4);
    @PRIM_RECT@(self, p_min, p_max, col);
} else {
    @PATH_RECT@(imgui_c89_ctx, self, p_min, p_max, rounding, flags);
    @PATH_FILL@(imgui_c89_ctx, self, col);
}
/* IMGUI_C89_FUNCTION_END draw_add_rect_filled */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_quad */
if ((col & @ALPHA_MASK@) == 0) return;
@PATH_LINE_TO@(imgui_c89_ctx, self, p1);
@PATH_LINE_TO@(imgui_c89_ctx, self, p2);
@PATH_LINE_TO@(imgui_c89_ctx, self, p3);
@PATH_LINE_TO@(imgui_c89_ctx, self, p4);
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, @CLOSED@);
/* IMGUI_C89_FUNCTION_END draw_add_quad */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_quad_filled */
if ((col & @ALPHA_MASK@) == 0) return;
@PATH_LINE_TO@(imgui_c89_ctx, self, p1);
@PATH_LINE_TO@(imgui_c89_ctx, self, p2);
@PATH_LINE_TO@(imgui_c89_ctx, self, p3);
@PATH_LINE_TO@(imgui_c89_ctx, self, p4);
@PATH_FILL@(imgui_c89_ctx, self, col);
/* IMGUI_C89_FUNCTION_END draw_add_quad_filled */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_triangle */
if ((col & @ALPHA_MASK@) == 0) return;
@PATH_LINE_TO@(imgui_c89_ctx, self, p1);
@PATH_LINE_TO@(imgui_c89_ctx, self, p2);
@PATH_LINE_TO@(imgui_c89_ctx, self, p3);
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, @CLOSED@);
/* IMGUI_C89_FUNCTION_END draw_add_triangle */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_triangle_filled */
if ((col & @ALPHA_MASK@) == 0) return;
@PATH_LINE_TO@(imgui_c89_ctx, self, p1);
@PATH_LINE_TO@(imgui_c89_ctx, self, p2);
@PATH_LINE_TO@(imgui_c89_ctx, self, p3);
@PATH_FILL@(imgui_c89_ctx, self, col);
/* IMGUI_C89_FUNCTION_END draw_add_triangle_filled */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_circle */
float a_max;

if ((col & @ALPHA_MASK@) == 0 || radius < 0.5f) return;
if (num_segments <= 0) {
    @PATH_ARC_FAST_EX@(imgui_c89_ctx, self, center, radius - 0.5f,
                      0, @ARCFAST_SAMPLES@, 0);
    self->_Path.Size--;
} else {
    num_segments = @CLAMP_INT@(num_segments, 3, @MAX_SEGMENTS@);
    a_max = @TWO_PI@ * ((float)num_segments - 1.0f) / (float)num_segments;
    @PATH_ARC_TO@(imgui_c89_ctx, self, center, radius - 0.5f,
                  0.0f, a_max, num_segments - 1);
}
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, @CLOSED@);
/* IMGUI_C89_FUNCTION_END draw_add_circle */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_circle_filled */
float a_max;

if ((col & @ALPHA_MASK@) == 0 || radius < 0.5f) return;
if (num_segments <= 0) {
    @PATH_ARC_FAST_EX@(imgui_c89_ctx, self, center, radius,
                      0, @ARCFAST_SAMPLES@, 0);
    self->_Path.Size--;
} else {
    num_segments = @CLAMP_INT@(num_segments, 3, @MAX_SEGMENTS@);
    a_max = @TWO_PI@ * ((float)num_segments - 1.0f) / (float)num_segments;
    @PATH_ARC_TO@(imgui_c89_ctx, self, center, radius,
                  0.0f, a_max, num_segments - 1);
}
@PATH_FILL@(imgui_c89_ctx, self, col);
/* IMGUI_C89_FUNCTION_END draw_add_circle_filled */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_ngon */
float a_max;

if ((col & @ALPHA_MASK@) == 0 || num_segments <= 2) return;
a_max = @TWO_PI@ * ((float)num_segments - 1.0f) / (float)num_segments;
@PATH_ARC_TO@(imgui_c89_ctx, self, center, radius - 0.5f,
              0.0f, a_max, num_segments - 1);
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, @CLOSED@);
/* IMGUI_C89_FUNCTION_END draw_add_ngon */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_ngon_filled */
float a_max;

if ((col & @ALPHA_MASK@) == 0 || num_segments <= 2) return;
a_max = @TWO_PI@ * ((float)num_segments - 1.0f) / (float)num_segments;
@PATH_ARC_TO@(imgui_c89_ctx, self, center, radius,
              0.0f, a_max, num_segments - 1);
@PATH_FILL@(imgui_c89_ctx, self, col);
/* IMGUI_C89_FUNCTION_END draw_add_ngon_filled */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_ellipse */
float a_max;

if ((col & @ALPHA_MASK@) == 0) return;
if (num_segments <= 0) {
    num_segments = @CALC_SEGMENTS@(self, @MAX_FLOAT@(radius->x, radius->y));
}
a_max = @TWO_PI@ * ((float)num_segments - 1.0f) / (float)num_segments;
@PATH_ELLIPTICAL@(imgui_c89_ctx, self, center, radius, rot,
                  0.0f, a_max, num_segments - 1);
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, @CLOSED@);
/* IMGUI_C89_FUNCTION_END draw_add_ellipse */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_ellipse_filled */
float a_max;

if ((col & @ALPHA_MASK@) == 0) return;
if (num_segments <= 0) {
    num_segments = @CALC_SEGMENTS@(self, @MAX_FLOAT@(radius->x, radius->y));
}
a_max = @TWO_PI@ * ((float)num_segments - 1.0f) / (float)num_segments;
@PATH_ELLIPTICAL@(imgui_c89_ctx, self, center, radius, rot,
                  0.0f, a_max, num_segments - 1);
@PATH_FILL@(imgui_c89_ctx, self, col);
/* IMGUI_C89_FUNCTION_END draw_add_ellipse_filled */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_bezier_cubic */
if ((col & @ALPHA_MASK@) == 0) return;
@PATH_LINE_TO@(imgui_c89_ctx, self, p1);
@PATH_BEZIER_CUBIC@(imgui_c89_ctx, self, p2, p3, p4, num_segments);
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, 0);
/* IMGUI_C89_FUNCTION_END draw_add_bezier_cubic */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_bezier_quadratic */
if ((col & @ALPHA_MASK@) == 0) return;
@PATH_LINE_TO@(imgui_c89_ctx, self, p1);
@PATH_BEZIER_QUADRATIC@(imgui_c89_ctx, self, p2, p3, num_segments);
@PATH_STROKE@(imgui_c89_ctx, self, col, thickness, 0);
/* IMGUI_C89_FUNCTION_END draw_add_bezier_quadratic */

/* IMGUI_C89_FUNCTION_BEGIN draw_try_merge_commands */
ImDrawCmd *current;
ImDrawCmd *previous;
size_t header_size;

current = self->CmdBuffer.Data + self->CmdBuffer.Size - 1;
previous = current - 1;
header_size = offsetof(ImDrawCmd, VtxOffset) + sizeof(unsigned int);
if (memcmp(current, previous, header_size) == 0 &&
    previous->IdxOffset + previous->ElemCount == current->IdxOffset &&
    current->UserCallback == NULL && previous->UserCallback == NULL) {
    previous->ElemCount += current->ElemCount;
    self->CmdBuffer.Size--;
}
/* IMGUI_C89_FUNCTION_END draw_try_merge_commands */

/* IMGUI_C89_FUNCTION_BEGIN draw_changed_clip_rect */
ImDrawCmd *current;
ImDrawCmd *previous;
size_t header_size;

current = self->CmdBuffer.Data + self->CmdBuffer.Size - 1;
if (current->ElemCount != 0 &&
    memcmp(&current->ClipRect, &self->_CmdHeader.ClipRect,
           sizeof(ImVec4)) != 0) {
    @ADD_DRAW_CMD@(imgui_c89_ctx, self);
    return;
}
if (current->UserCallback != NULL) {
    @ASSERT_602@;
}
previous = current - 1;
header_size = offsetof(ImDrawCmd, VtxOffset) + sizeof(unsigned int);
if (current->ElemCount == 0 && self->CmdBuffer.Size > 1 &&
    memcmp(&self->_CmdHeader, previous, header_size) == 0 &&
    previous->IdxOffset + previous->ElemCount == current->IdxOffset &&
    previous->UserCallback == NULL) {
    self->CmdBuffer.Size--;
    return;
}
current->ClipRect = self->_CmdHeader.ClipRect;
/* IMGUI_C89_FUNCTION_END draw_changed_clip_rect */

/* IMGUI_C89_FUNCTION_BEGIN draw_changed_texture */
ImDrawCmd *current;
ImDrawCmd *previous;
size_t header_size;

current = self->CmdBuffer.Data + self->CmdBuffer.Size - 1;
if (current->ElemCount != 0 &&
    (current->TexRef._TexID != self->_CmdHeader.TexRef._TexID ||
     current->TexRef._TexData != self->_CmdHeader.TexRef._TexData)) {
    @ADD_DRAW_CMD@(imgui_c89_ctx, self);
    return;
}
if (current->UserCallback != NULL) return;
previous = current - 1;
header_size = offsetof(ImDrawCmd, VtxOffset) + sizeof(unsigned int);
if (current->ElemCount == 0 && self->CmdBuffer.Size > 1 &&
    memcmp(&self->_CmdHeader, previous, header_size) == 0 &&
    previous->IdxOffset + previous->ElemCount == current->IdxOffset &&
    previous->UserCallback == NULL) {
    self->CmdBuffer.Size--;
    return;
}
current->TexRef = self->_CmdHeader.TexRef;
/* IMGUI_C89_FUNCTION_END draw_changed_texture */

/* IMGUI_C89_FUNCTION_BEGIN draw_changed_vtx_offset */
ImDrawCmd *current;

self->_VtxCurrentIdx = 0;
current = self->CmdBuffer.Data + self->CmdBuffer.Size - 1;
if (current->ElemCount != 0) {
    @ADD_DRAW_CMD@(imgui_c89_ctx, self);
    return;
}
if (current->UserCallback != NULL) {
    @ASSERT_651@;
}
current->VtxOffset = self->_CmdHeader.VtxOffset;
/* IMGUI_C89_FUNCTION_END draw_changed_vtx_offset */

/* IMGUI_C89_FUNCTION_BEGIN draw_calc_circle_segments */
int radius_index;

radius_index = (int)(radius + 0.999f);
if (radius_index >= 0 && radius_index < 64) {
    return self->_Data->CircleSegmentCounts[radius_index];
}
return @CLAMP_INT@(
    (((int)ceilf(@PI@ / acosf(1.0f -
      @MIN_FLOAT@(self->_Data->CircleTessellationMaxError, radius) /
      radius)) + 1) / 2) * 2,
    4, @MAX_SEGMENTS@);
/* IMGUI_C89_FUNCTION_END draw_calc_circle_segments */

/* IMGUI_C89_FUNCTION_BEGIN draw_push_clip_rect */
ImVec4 clip;

clip.x = cr_min->x;
clip.y = cr_min->y;
clip.z = cr_max->x;
clip.w = cr_max->y;
if (intersect_with_current_clip_rect) {
    if (clip.x < self->_CmdHeader.ClipRect.x) {
        clip.x = self->_CmdHeader.ClipRect.x;
    }
    if (clip.y < self->_CmdHeader.ClipRect.y) {
        clip.y = self->_CmdHeader.ClipRect.y;
    }
    if (clip.z > self->_CmdHeader.ClipRect.z) {
        clip.z = self->_CmdHeader.ClipRect.z;
    }
    if (clip.w > self->_CmdHeader.ClipRect.w) {
        clip.w = self->_CmdHeader.ClipRect.w;
    }
}
clip.z = @MAX_FLOAT@(clip.x, clip.z);
clip.w = @MAX_FLOAT@(clip.y, clip.w);
@CLIP_PUSH@(imgui_c89_ctx, &self->_ClipRectStack, &clip);
self->_CmdHeader.ClipRect = clip;
@ON_CLIP_CHANGED@(imgui_c89_ctx, self);
/* IMGUI_C89_FUNCTION_END draw_push_clip_rect */

/* IMGUI_C89_FUNCTION_BEGIN draw_push_clip_rect_fullscreen */
ImVec2 min;
ImVec2 max;

min.x = self->_Data->ClipRectFullscreen.x;
min.y = self->_Data->ClipRectFullscreen.y;
max.x = self->_Data->ClipRectFullscreen.z;
max.y = self->_Data->ClipRectFullscreen.w;
@PUSH_CLIP@(imgui_c89_ctx, self, &min, &max, 0);
/* IMGUI_C89_FUNCTION_END draw_push_clip_rect_fullscreen */

/* IMGUI_C89_FUNCTION_BEGIN draw_pop_clip_rect */
self->_ClipRectStack.Size--;
self->_CmdHeader.ClipRect = self->_ClipRectStack.Size == 0
    ? self->_Data->ClipRectFullscreen
    : self->_ClipRectStack.Data[self->_ClipRectStack.Size - 1];
@ON_CLIP_CHANGED@(imgui_c89_ctx, self);
/* IMGUI_C89_FUNCTION_END draw_pop_clip_rect */

/* IMGUI_C89_FUNCTION_BEGIN draw_push_texture */
@TEXTURE_PUSH@(imgui_c89_ctx, &self->_TextureStack, &tex_ref);
self->_CmdHeader.TexRef = tex_ref;
if (tex_ref._TexData != NULL) {
    if (tex_ref._TexData->WantDestroyNextFrame) {
        @ASSERT_702@;
    }
}
@ON_TEXTURE_CHANGED@(imgui_c89_ctx, self);
/* IMGUI_C89_FUNCTION_END draw_push_texture */

/* IMGUI_C89_FUNCTION_BEGIN draw_pop_texture */
self->_TextureStack.Size--;
if (self->_TextureStack.Size == 0) {
    self->_CmdHeader.TexRef._TexData = NULL;
    self->_CmdHeader.TexRef._TexID = (ImTextureID)0;
} else {
    self->_CmdHeader.TexRef =
        self->_TextureStack.Data[self->_TextureStack.Size - 1];
}
@ON_TEXTURE_CHANGED@(imgui_c89_ctx, self);
/* IMGUI_C89_FUNCTION_END draw_pop_texture */

/* IMGUI_C89_FUNCTION_BEGIN draw_set_texture */
if (self->_CmdHeader.TexRef._TexID == tex_ref._TexID &&
    self->_CmdHeader.TexRef._TexData == tex_ref._TexData) return;
self->_CmdHeader.TexRef = tex_ref;
self->_TextureStack.Data[self->_TextureStack.Size - 1] = tex_ref;
@ON_TEXTURE_CHANGED@(imgui_c89_ctx, self);
/* IMGUI_C89_FUNCTION_END draw_set_texture */

/* IMGUI_C89_FUNCTION_BEGIN draw_prim_reserve */
ImDrawCmd *command;
int old_size;

if (sizeof(ImDrawIdx) == 2 &&
    self->_VtxCurrentIdx + vtx_count >= (1 << 16) &&
    (self->Flags & @ALLOW_VTX_OFFSET@)) {
    self->_CmdHeader.VtxOffset = self->VtxBuffer.Size;
    @ON_VTX_CHANGED@(imgui_c89_ctx, self);
}
command = self->CmdBuffer.Data + self->CmdBuffer.Size - 1;
command->ElemCount += idx_count;
old_size = self->VtxBuffer.Size;
@VTX_RESIZE@(imgui_c89_ctx, &self->VtxBuffer, old_size + vtx_count);
self->_VtxWritePtr = self->VtxBuffer.Data + old_size;
old_size = self->IdxBuffer.Size;
@IDX_RESIZE@(imgui_c89_ctx, &self->IdxBuffer, old_size + idx_count);
self->_IdxWritePtr = self->IdxBuffer.Data + old_size;
/* IMGUI_C89_FUNCTION_END draw_prim_reserve */

/* IMGUI_C89_FUNCTION_BEGIN draw_prim_unreserve */
ImDrawCmd *command;

command = self->CmdBuffer.Data + self->CmdBuffer.Size - 1;
command->ElemCount -= idx_count;
self->VtxBuffer.Size -= vtx_count;
self->IdxBuffer.Size -= idx_count;
/* IMGUI_C89_FUNCTION_END draw_prim_unreserve */

/* IMGUI_C89_FUNCTION_BEGIN draw_data_scale_clip_rects */
ImDrawList *list;
ImDrawCmd *command;
int i;
int j;

for (i = 0; i < self->CmdLists.Size; i++) {
    list = self->CmdLists.Data[i];
    for (j = 0; j < list->CmdBuffer.Size; j++) {
        command = &list->CmdBuffer.Data[j];
        command->ClipRect.x *= fb_scale->x;
        command->ClipRect.y *= fb_scale->y;
        command->ClipRect.z *= fb_scale->x;
        command->ClipRect.w *= fb_scale->y;
    }
}
/* IMGUI_C89_FUNCTION_END draw_data_scale_clip_rects */

/* IMGUI_C89_FUNCTION_BEGIN draw_data_clear */
self->Valid = 0;
self->FrameCount = 0;
self->TotalIdxCount = 0;
self->TotalVtxCount = 0;
self->CmdLists.Size = 0;
self->DisplayPos.x = 0.0f;
self->DisplayPos.y = 0.0f;
self->DisplaySize = self->DisplayPos;
self->FramebufferScale = self->DisplayPos;
self->OwnerViewport = NULL;
self->Textures = NULL;
@RESET_OBSOLETE_CMD_LIST_COUNT@
/* IMGUI_C89_FUNCTION_END draw_data_clear */

/* IMGUI_C89_FUNCTION_BEGIN draw_data_add_list */
@POP_UNUSED@(draw_list);
@ADD_DRAW_LIST_EX@(imgui_c89_ctx, self, &self->CmdLists, draw_list);
/* IMGUI_C89_FUNCTION_END draw_data_add_list */

/* IMGUI_C89_FUNCTION_BEGIN bezier_cubic_calc */
ImVec2 result;
float u;
float w1;
float w2;
float w3;
float w4;

u = 1.0f - t;
w1 = u * u * u;
w2 = 3.0f * u * u * t;
w3 = 3.0f * u * t * t;
w4 = t * t * t;
result.x = w1 * p1->x + w2 * p2->x + w3 * p3->x + w4 * p4->x;
result.y = w1 * p1->y + w2 * p2->y + w3 * p3->y + w4 * p4->y;
return result;
/* IMGUI_C89_FUNCTION_END bezier_cubic_calc */

/* IMGUI_C89_FUNCTION_BEGIN bezier_quadratic_calc */
ImVec2 result;
float u;
float w1;
float w2;
float w3;

u = 1.0f - t;
w1 = u * u;
w2 = 2.0f * u * t;
w3 = t * t;
result.x = w1 * p1->x + w2 * p2->x + w3 * p3->x;
result.y = w1 * p1->y + w2 * p2->y + w3 * p3->y;
return result;
/* IMGUI_C89_FUNCTION_END bezier_quadratic_calc */

/* IMGUI_C89_FUNCTION_BEGIN bezier_cubic_casteljau */
ImVec2 point;
float dx;
float dy;
float d2;
float d3;
float x12;
float y12;
float x23;
float y23;
float x34;
float y34;
float x123;
float y123;
float x234;
float y234;
float x1234;
float y1234;

dx = x4 - x1;
dy = y4 - y1;
d2 = (x2 - x4) * dy - (y2 - y4) * dx;
d3 = (x3 - x4) * dy - (y3 - y4) * dx;
if (d2 < 0.0f) {
    d2 = -d2;
}
if (d3 < 0.0f) {
    d3 = -d3;
}
if ((d2 + d3) * (d2 + d3) < tess_tol * (dx * dx + dy * dy)) {
    point.x = x4;
    point.y = y4;
    @PATH_PUSH@(imgui_c89_ctx, path, &point);
} else if (level < 10) {
    x12 = (x1 + x2) * 0.5f;
    y12 = (y1 + y2) * 0.5f;
    x23 = (x2 + x3) * 0.5f;
    y23 = (y2 + y3) * 0.5f;
    x34 = (x3 + x4) * 0.5f;
    y34 = (y3 + y4) * 0.5f;
    x123 = (x12 + x23) * 0.5f;
    y123 = (y12 + y23) * 0.5f;
    x234 = (x23 + x34) * 0.5f;
    y234 = (y23 + y34) * 0.5f;
    x1234 = (x123 + x234) * 0.5f;
    y1234 = (y123 + y234) * 0.5f;
    @CUBIC_CASTELJAU@(imgui_c89_ctx, path, x1, y1, x12, y12,
                      x123, y123, x1234, y1234, tess_tol, level + 1);
    @CUBIC_CASTELJAU@(imgui_c89_ctx, path, x1234, y1234, x234, y234,
                      x34, y34, x4, y4, tess_tol, level + 1);
}
/* IMGUI_C89_FUNCTION_END bezier_cubic_casteljau */

/* IMGUI_C89_FUNCTION_BEGIN bezier_quadratic_casteljau */
ImVec2 point;
float dx;
float dy;
float det;
float x12;
float y12;
float x23;
float y23;
float x123;
float y123;

dx = x3 - x1;
dy = y3 - y1;
det = (x2 - x3) * dy - (y2 - y3) * dx;
if (det * det * 4.0f < tess_tol * (dx * dx + dy * dy)) {
    point.x = x3;
    point.y = y3;
    @PATH_PUSH@(imgui_c89_ctx, path, &point);
} else if (level < 10) {
    x12 = (x1 + x2) * 0.5f;
    y12 = (y1 + y2) * 0.5f;
    x23 = (x2 + x3) * 0.5f;
    y23 = (y2 + y3) * 0.5f;
    x123 = (x12 + x23) * 0.5f;
    y123 = (y12 + y23) * 0.5f;
    @QUADRATIC_CASTELJAU@(imgui_c89_ctx, path, x1, y1, x12, y12,
                          x123, y123, tess_tol, level + 1);
    @QUADRATIC_CASTELJAU@(imgui_c89_ctx, path, x123, y123, x23, y23,
                          x3, y3, tess_tol, level + 1);
}
/* IMGUI_C89_FUNCTION_END bezier_quadratic_casteljau */

/* IMGUI_C89_FUNCTION_BEGIN draw_path_arc_n */
ImVec2 point;
float angle;
int i;

if (radius < 0.5f) {
    @PATH_PUSH@(imgui_c89_ctx, &self->_Path, center);
    return;
}
@PATH_RESERVE@(imgui_c89_ctx, &self->_Path,
               self->_Path.Size + num_segments + 1);
for (i = 0; i <= num_segments; i++) {
    angle = a_min + (float)i / (float)num_segments * (a_max - a_min);
    point.x = center->x + cosf(angle) * radius;
    point.y = center->y + sinf(angle) * radius;
    @PATH_PUSH@(imgui_c89_ctx, &self->_Path, &point);
}
/* IMGUI_C89_FUNCTION_END draw_path_arc_n */

/* IMGUI_C89_FUNCTION_BEGIN draw_path_arc_fast */
if (radius < 0.5f) {
    @PATH_PUSH@(imgui_c89_ctx, &self->_Path, center);
    return;
}
@PATH_ARC_FAST_EX@(imgui_c89_ctx, self, center, radius,
                  a_min_of_12 * @ARCFAST_SAMPLES@ / 12,
                  a_max_of_12 * @ARCFAST_SAMPLES@ / 12, 0);
/* IMGUI_C89_FUNCTION_END draw_path_arc_fast */

/* IMGUI_C89_FUNCTION_BEGIN draw_path_elliptical */
ImVec2 point;
float cos_rotation;
float sin_rotation;
float x;
float y;
float angle;
int i;

if (num_segments <= 0) {
    num_segments = @CALC_SEGMENTS@(self, @MAX_FLOAT@(radius->x, radius->y));
}
@PATH_RESERVE@(imgui_c89_ctx, &self->_Path,
               self->_Path.Size + num_segments + 1);
cos_rotation = cosf(rot);
sin_rotation = sinf(rot);
for (i = 0; i <= num_segments; i++) {
    angle = a_min + (float)i / (float)num_segments * (a_max - a_min);
    x = cosf(angle) * radius->x;
    y = sinf(angle) * radius->y;
    point.x = x * cos_rotation - y * sin_rotation + center->x;
    point.y = x * sin_rotation + y * cos_rotation + center->y;
    @PATH_PUSH@(imgui_c89_ctx, &self->_Path, &point);
}
/* IMGUI_C89_FUNCTION_END draw_path_elliptical */

/* IMGUI_C89_FUNCTION_BEGIN draw_path_bezier_cubic */
ImVec2 point;
ImVec2 p1;
float step;
int i;

p1 = self->_Path.Data[self->_Path.Size - 1];
if (num_segments == 0) {
    if (self->_Data->CurveTessellationTol <= 0.0f) {
        @ASSERT_1421@;
    }
    @CUBIC_CASTELJAU@(imgui_c89_ctx, &self->_Path,
                      p1.x, p1.y, p2->x, p2->y, p3->x, p3->y,
                      p4->x, p4->y, self->_Data->CurveTessellationTol, 0);
} else {
    step = 1.0f / (float)num_segments;
    for (i = 1; i <= num_segments; i++) {
        point = @BEZIER_CUBIC_CALC@(&p1, p2, p3, p4, step * i);
        @PATH_PUSH@(imgui_c89_ctx, &self->_Path, &point);
    }
}
/* IMGUI_C89_FUNCTION_END draw_path_bezier_cubic */

/* IMGUI_C89_FUNCTION_BEGIN draw_path_bezier_quadratic */
ImVec2 point;
ImVec2 p1;
float step;
int i;

p1 = self->_Path.Data[self->_Path.Size - 1];
if (num_segments == 0) {
    if (self->_Data->CurveTessellationTol <= 0.0f) {
