}
/* IMGUI_C89_FUNCTION_END draw_path_bezier_quadratic */

/* IMGUI_C89_FUNCTION_BEGIN draw_add_text_full */
ImVec4 clip;
ImDrawTextFlags text_flags;

if ((col & @ALPHA_MASK@) == 0) return;
if (text_begin == text_end || text_begin[0] == '\0') return;
if (font == NULL) {
    font = self->_Data->Font;
}
if (font_size == 0.0f) {
    font_size = self->_Data->FontSize;
}
clip = self->_CmdHeader.ClipRect;
text_flags = @TEXT_FLAGS_NONE@;
if (cpu_fine_clip_rect != NULL) {
    clip.x = @MAX_FLOAT@(clip.x, cpu_fine_clip_rect->x);
    clip.y = @MAX_FLOAT@(clip.y, cpu_fine_clip_rect->y);
    clip.z = @MIN_FLOAT@(clip.z, cpu_fine_clip_rect->z);
    clip.w = @MIN_FLOAT@(clip.w, cpu_fine_clip_rect->w);
    text_flags = @CPU_FINE_CLIP@;
