/* IMGUI_C89_FUNCTION_BEGIN glyph_ranges_add_text */
unsigned int codepoint;
int length;

if (text_end == NULL) {
    text_end = text + strlen(text);
}
while (text < text_end) {
    codepoint = 0;
    length = @TEXT_FROM_UTF8@(&codepoint, text, text_end);
    if (length == 0) break;
    text += length;
    @RANGES_ADD_CHAR@(self, (ImWchar)codepoint);
}
/* IMGUI_C89_FUNCTION_END glyph_ranges_add_text */

/* IMGUI_C89_FUNCTION_BEGIN glyph_ranges_add_ranges */
unsigned int codepoint;

while (ranges[0] != 0) {
    for (codepoint = ranges[0];
         codepoint <= ranges[1] && codepoint <= @MAX_CODEPOINT@;
         codepoint++) {
        @RANGES_ADD_CHAR@(self, (ImWchar)codepoint);
    }
    ranges += 2;
}
/* IMGUI_C89_FUNCTION_END glyph_ranges_add_ranges */

/* IMGUI_C89_FUNCTION_BEGIN glyph_ranges_build */
ImWchar value;
int codepoint;

for (codepoint = 0; codepoint <= @MAX_CODEPOINT@; codepoint++) {
    if (!@RANGES_GET_BIT@(self, (size_t)codepoint)) continue;
    value = (ImWchar)codepoint;
    @WCHAR_PUSH@(imgui_c89_ctx, out_ranges, &value);
    while (codepoint < @MAX_CODEPOINT@ &&
           @RANGES_GET_BIT@(self, (size_t)(codepoint + 1))) {
        codepoint++;
    }
    value = (ImWchar)codepoint;
    @WCHAR_PUSH@(imgui_c89_ctx, out_ranges, &value);
}
value = 0;
@WCHAR_PUSH@(imgui_c89_ctx, out_ranges, &value);
