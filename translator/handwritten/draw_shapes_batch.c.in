/* IMGUI_C89_FUNCTION_BEGIN draw_add_text_simple */
@ADD_TEXT_FULL@(imgui_c89_ctx, self, self->_Data->Font,
                self->_Data->FontSize, pos, col, text_begin, text_end,
                0.0f, NULL);
