/* Handwritten C89 table draw-channel setup and switching. */

/* IMGUI_C89_FUNCTION_BEGIN table_push_background_channel */
ImGuiWindow *window;
ImGuiTable *table;
window = imgui_c89_ctx->CurrentWindow;
table = imgui_c89_ctx->CurrentTable;
table->HostBackupInnerClipRect = window->ClipRect;
@SET_CLIP@(window, &table->Bg2ClipRectForDrawCmd);
@SET_CHANNEL@(imgui_c89_ctx, table->DrawSplitter, window->DrawList,
              table->Bg2DrawChannelCurrent);
/* IMGUI_C89_FUNCTION_END table_push_background_channel */

/* IMGUI_C89_FUNCTION_BEGIN table_pop_background_channel */
ImGuiWindow *window;
ImGuiTable *table;
window = imgui_c89_ctx->CurrentWindow;
table = imgui_c89_ctx->CurrentTable;
@SET_CLIP@(window, &table->HostBackupInnerClipRect);
@SET_CHANNEL@(imgui_c89_ctx, table->DrawSplitter, window->DrawList,
              table->Columns.Data[table->CurrentColumn].DrawChannelCurrent);
/* IMGUI_C89_FUNCTION_END table_pop_background_channel */

/* IMGUI_C89_FUNCTION_BEGIN table_push_column_channel */
ImGuiWindow *window;
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
if (table->Flags & @NO_CLIP@)
    return;
window = imgui_c89_ctx->CurrentWindow;
@SET_CLIP@(window, &table->Columns.Data[column_n].ClipRect);
@SET_CHANNEL@(imgui_c89_ctx, table->DrawSplitter, window->DrawList,
              table->Columns.Data[column_n].DrawChannelCurrent);
/* IMGUI_C89_FUNCTION_END table_push_column_channel */

/* IMGUI_C89_FUNCTION_BEGIN table_pop_column_channel */
ImGuiWindow *window;
ImGuiTable *table;
table = imgui_c89_ctx->CurrentTable;
if ((table->Flags & @NO_CLIP@) || table->CurrentColumn == -1)
    return;
window = imgui_c89_ctx->CurrentWindow;
@SET_CLIP@(window, &table->Columns.Data[table->CurrentColumn].ClipRect);
@SET_CHANNEL@(imgui_c89_ctx, table->DrawSplitter, window->DrawList,
              table->Columns.Data[table->CurrentColumn].DrawChannelCurrent);
/* IMGUI_C89_FUNCTION_END table_pop_column_channel */

/* IMGUI_C89_FUNCTION_BEGIN table_setup_draw_channels */
ImGuiTableColumn *column;
int freeze_multiplier;
int row_channels;
int background_channels;
int dummy_channels;
int total_channels;
int draw_channel;
int bg2_frozen;
int n;
bg2_frozen = 1;
freeze_multiplier = table->FreezeRowsCount > 0 ? 2 : 1;
row_channels = table->Flags & @NO_CLIP@ ? 1 : table->ColumnsEnabledCount;
background_channels = 1 + freeze_multiplier;
dummy_channels = table->ColumnsEnabledCount < table->ColumnsCount ||
    memcmp(table->VisibleMaskByIndex, table->EnabledMaskByIndex,
           @BIT_STORAGE_BYTES@(table->ColumnsCount)) != 0;
total_channels = background_channels + row_channels * freeze_multiplier +
                 dummy_channels;
@SPLIT@(imgui_c89_ctx, table->DrawSplitter, table->InnerWindow->DrawList,
        total_channels);
table->DummyDrawChannel = (ImGuiTableDrawChannelIdx)
    (dummy_channels ? total_channels - 1 : -1);
table->Bg2DrawChannelCurrent = (ImGuiTableDrawChannelIdx)bg2_frozen;
table->Bg2DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)
    (table->FreezeRowsCount ? 2 + row_channels : bg2_frozen);
draw_channel = 2;
for (n = 0; n < table->ColumnsCount; n++)
{
    column = &table->Columns.Data[n];
    if (column->IsVisibleX && column->IsVisibleY)
    {
        column->DrawChannelFrozen = (ImGuiTableDrawChannelIdx)draw_channel;
        column->DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)
            (draw_channel + (table->FreezeRowsCount ? row_channels + 1 : 0));
        if (!(table->Flags & @NO_CLIP@))
            draw_channel++;
    }
    else
        column->DrawChannelFrozen = column->DrawChannelUnfrozen =
            table->DummyDrawChannel;
    column->DrawChannelCurrent = column->DrawChannelFrozen;
}
table->BgClipRect = table->InnerClipRect;
table->Bg0ClipRectForDrawCmd = table->OuterWindow->ClipRect;
table->Bg2ClipRectForDrawCmd = table->HostClipRect;
/* IMGUI_C89_FUNCTION_END table_setup_draw_channels */
