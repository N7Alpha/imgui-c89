/* IMGUI_C89_FUNCTION_BEGIN font_src_init */
{
    ImGuiContext *ctx;
    @STB_SRC_DATA@ *data;
    int font_offset;
    int font_initialized;
    float ref_size;

    ctx = atlas->OwnerContext ? atlas->OwnerContext : GImGui;
    data = (@STB_SRC_DATA@ *)imgui_mem_alloc(ctx, sizeof(*data));
    if (src->FontLoaderData != NULL) {
        @ASSERT_4703@;
    }
    font_offset = @STB_FONT_OFFSET@((const unsigned char *)src->FontData, src->FontNo);
    if (font_offset < 0) {
        imgui_mem_free(ctx, data);
        if (@ERROR_LOG@(ctx,
                "stbtt_GetFontOffsetForIndex(): FontData is incorrect, or FontNo cannot be found.")) {
            @ASSERT_4710@;
        }
        return 0;
    }

    font_initialized = @STB_INIT_FONT@(&data->FontInfo, (const unsigned char *)src->FontData, font_offset);
    if (!font_initialized) {
        imgui_mem_free(ctx, data);
        if (@ERROR_LOG@(ctx,
                "stbtt_InitFont(): failed to parse FontData. It is correct and complete? Check FontDataSize.")) {
            @ASSERT_4716@;
        }
        return 0;
    }

    src->FontLoaderData = data;
    ref_size = src->DstFont->Sources.Data[0]->SizePixels;
    if (src->MergeMode && src->SizePixels == 0.0f) {
        src->SizePixels = ref_size;
    }
    data->ScaleFactor = @STB_SCALE_PIXEL_HEIGHT@(&data->FontInfo, 1.0f);
    if (src->MergeMode && src->SizePixels != 0.0f && ref_size != 0.0f) {
        data->ScaleFactor *= src->SizePixels / ref_size;
    }
    data->ScaleFactor *= src->ExtraSizeScale;
    return 1;
}
/* IMGUI_C89_FUNCTION_END font_src_init */

/* IMGUI_C89_FUNCTION_BEGIN build_load_glyph */
{
    ImFont *font;
    ImFontAtlas *atlas;
    ImWchar original_codepoint;
    ImFontGlyph *ellipsis_glyph;
    unsigned char *loader_data;
    int src_idx;
    ImFontConfig *src;
    const ImFontLoader *loader;

    font = baked->OwnerFont;
    atlas = font->OwnerAtlas;
    if (atlas->Locked || (font->Flags & @NO_LOAD_GLYPHS@) != 0) {
        if (baked->FallbackGlyphIndex == -1 && !baked->LoadNoFallback) {
            @SETUP_FALLBACK@(imgui_c89_ctx, baked);
        }
        return NULL;
    }

    original_codepoint = codepoint;
    @REMAP_CODEPOINT@(atlas, font, &codepoint);
    if (codepoint == font->EllipsisChar && font->EllipsisAutoBake) {
        ellipsis_glyph = @SETUP_ELLIPSIS@(imgui_c89_ctx, atlas, baked);
        if (ellipsis_glyph != NULL) return ellipsis_glyph;
    }

    loader_data = (unsigned char *)baked->FontLoaderDatas;
    for (src_idx = 0; src_idx < font->Sources.Size; src_idx++) {
        src = font->Sources.Data[src_idx];
        loader = src->FontLoader != NULL ? src->FontLoader : atlas->FontLoader;
        if (src->GlyphExcludeRanges == NULL || @ACCEPT_CODEPOINT@(src, codepoint)) {
            if (only_load_advance_x == NULL) {
                ImFontGlyph glyph;

                memset(&glyph, 0, sizeof(glyph));
                glyph.PackId = -1;

                if (loader->FontBakedLoadGlyph(atlas, src, baked, loader_data, codepoint, &glyph, NULL)) {
                    glyph.Codepoint = original_codepoint;
                    glyph.SourceIdx = src_idx;
                    return @ADD_FONT_GLYPH@(imgui_c89_ctx, atlas, baked, src, &glyph);
                }
            } else {
                if (loader->FontBakedLoadGlyph(atlas, src, baked, loader_data, codepoint, NULL, only_load_advance_x)) {
                    @ADD_ADVANCE@(imgui_c89_ctx, atlas, baked, src, codepoint, *only_load_advance_x);
                    return NULL;
                }
            }
        }
        loader_data += loader->FontBakedSrcLoaderDataSize;
    }

    if (baked->LoadNoFallback) return NULL;
    if (baked->FallbackGlyphIndex == -1) {
        @SETUP_FALLBACK@(imgui_c89_ctx, baked);
    }
    @GROW_INDEX@(imgui_c89_ctx, baked, codepoint + 1);
    baked->IndexAdvanceX.Data[codepoint] = baked->FallbackAdvanceX;
    baked->IndexLookup.Data[codepoint] = @GLYPH_NOT_FOUND@;
    return NULL;
}
/* IMGUI_C89_FUNCTION_END build_load_glyph */

/* IMGUI_C89_FUNCTION_BEGIN stb_baked_load_glyph */
{
    ImGuiContext *ctx;
    @STB_SRC_DATA@ *data;
    int glyph_index;
    int oversample_h;
    int oversample_v;
    float scale_layout;
    float density;
    float scale_raster_x;
    float scale_raster_y;
    int x0;
    int y0;
    int x1;
    int y1;
    int advance;
    int lsb;
    int w;
    int h;
    ImFontAtlasRectId pack_id;
    ImTextureRect *rect;
    unsigned char *bitmap;
    float sub_x;
    float sub_y;
    float ref_size;
    float offsets_scale;
    float off_x;
    float off_y;
    float recip_h;
    float recip_v;

    ctx = atlas->OwnerContext ? atlas->OwnerContext : GImGui;
    (void)arg_3;
    data = (@STB_SRC_DATA@ *)src->FontLoaderData;
    if (data == NULL) {
        @ASSERT_4774@;
    }
    glyph_index = @STB_FIND_GLYPH@(&data->FontInfo, codepoint);
    if (glyph_index == 0) return 0;

    @GET_OVERSAMPLE@(src, baked, &oversample_h, &oversample_v);
    scale_layout = data->ScaleFactor * baked->Size;
    density = src->RasterizerDensity * baked->RasterizerDensity;
    scale_raster_x = data->ScaleFactor * baked->Size * density * (float)oversample_h;
    scale_raster_y = data->ScaleFactor * baked->Size * density * (float)oversample_v;
    @STB_BITMAP_BOX_SUBPIXEL@(&data->FontInfo, glyph_index, scale_raster_x, scale_raster_y,
                             0.0f, 0.0f, &x0, &y0, &x1, &y1);
    @STB_HMETRICS@(&data->FontInfo, glyph_index, &advance, &lsb);

    if (out_advance_x != NULL) {
        if (out_glyph != NULL) {
            @ASSERT_4796@;
        }
        *out_advance_x = (float)advance * scale_layout;
        return 1;
    }

    out_glyph->Codepoint = codepoint;
    out_glyph->AdvanceX = (float)advance * scale_layout;
    if (x0 == x1 || y0 == y1) return 1;

    w = x1 - x0 + oversample_h - 1;
    h = y1 - y0 + oversample_v - 1;
    pack_id = @PACK_ADD_RECT@(ctx, atlas, w, h, NULL);
    if (pack_id == @INVALID_RECT_ID@) {
        @ASSERT_4816@;
        return 0;
    }
    rect = @PACK_GET_RECT@(atlas, pack_id);

    @STB_BITMAP_BOX@(&data->FontInfo, glyph_index, scale_raster_x, scale_raster_y,
                     &x0, &y0, &x1, &y1);
    @BYTE_RESIZE@(ctx, &atlas->Builder->TempBuffer, w * h);
    bitmap = atlas->Builder->TempBuffer.Data;
    memset(bitmap, 0, (size_t)(w * h));
    @STB_MAKE_BITMAP_PREFILTER@(ctx, &data->FontInfo, bitmap, w, h, w,
                                scale_raster_x, scale_raster_y, 0.0f, 0.0f,
                                oversample_h, oversample_v, &sub_x, &sub_y,
                                glyph_index);

    ref_size = baked->OwnerFont->Sources.Data[0]->SizePixels;
    offsets_scale = ref_size != 0.0f ? baked->Size / ref_size : 1.0f;
    off_x = @FLOOR@(src->GlyphOffset.x * offsets_scale + 0.5f) + sub_x;
    off_y = @FLOOR@(src->GlyphOffset.y * offsets_scale + 0.5f) + sub_y +
            (float)((int)(baked->Ascent + 0.5f));
    recip_h = 1.0f / ((float)oversample_h * density);
    recip_v = 1.0f / ((float)oversample_v * density);
    out_glyph->X0 = (float)x0 * recip_h + off_x;
    out_glyph->Y0 = (float)y0 * recip_v + off_y;
    out_glyph->X1 = (float)(x0 + (int)rect->w) * recip_h + off_x;
    out_glyph->Y1 = (float)(y0 + (int)rect->h) * recip_v + off_y;
    out_glyph->Visible = 1;
    out_glyph->PackId = pack_id;
    @SET_GLYPH_BITMAP@(ctx, atlas, baked, src, out_glyph, rect, bitmap, @FORMAT_ALPHA8@, w);
    return 1;
}
/* IMGUI_C89_FUNCTION_END stb_baked_load_glyph */
