/* IMGUI_C89_FUNCTION_BEGIN font_calc_text_size_ex */
ImFontBaked *baked;
ImVec2 text_size;
const char *s;
const char *word_wrap_eol;
const char *prev_s;
float line_height;
float line_width;
float char_width;
float scale;
unsigned int c;
int word_wrap_enabled;

if (!text_end)
    text_end = text_begin + strlen(text_begin);
if (!text_end_display)
    text_end_display = text_end;

baked = @GET_BAKED@(imgui_c89_ctx, font, size, -1.0f);
line_height = size;
scale = line_height / baked->Size;
text_size.x = 0.0f;
text_size.y = 0.0f;
line_width = 0.0f;
word_wrap_enabled = wrap_width > 0.0f;
word_wrap_eol = 0;
s = text_begin;

while (s < text_end_display)
{
    if (word_wrap_enabled)
    {
        if (!word_wrap_eol)
            word_wrap_eol = @CALC_WORD_WRAP@(
                imgui_c89_ctx, font, size, s, text_end,
                wrap_width - line_width, flags);
        if (s >= word_wrap_eol)
        {
            if (text_size.x < line_width)
                text_size.x = line_width;
            text_size.y += line_height;
            line_width = 0.0f;
            s = @NEXT_LINE_START@(s, text_end, flags);
            if (flags & @STOP_ON_NEW_LINE@)
                break;
            word_wrap_eol = 0;
            continue;
        }
    }

    prev_s = s;
    c = (unsigned int)(unsigned char)*s;
    if (c < 0x80u)
        ++s;
    else
        s += @TEXT_CHAR_FROM_UTF8@(&c, s, text_end);

    if (c == '\n')
    {
        if (text_size.x < line_width)
            text_size.x = line_width;
        text_size.y += line_height;
        line_width = 0.0f;
        if (flags & @STOP_ON_NEW_LINE@)
            break;
        continue;
    }
    if (c == '\r')
        continue;

    char_width = c < (unsigned int)baked->IndexAdvanceX.Size
               ? baked->IndexAdvanceX.Data[c] : -1.0f;
    if (char_width < 0.0f)
        char_width = @LOAD_ADVANCE@(imgui_c89_ctx, baked, c);
    char_width *= scale;
    if (line_width + char_width >= max_width)
    {
        s = prev_s;
        break;
    }
    line_width += char_width;
}

if (text_size.x < line_width)
    text_size.x = line_width;
if (out_offset)
{
    out_offset->x = line_width;
    out_offset->y = text_size.y + line_height;
}
if (line_width > 0.0f || text_size.y == 0.0f)
    text_size.y += line_height;
if (out_remaining)
    *out_remaining = s;
return text_size;
/* IMGUI_C89_FUNCTION_END font_calc_text_size_ex */

/* IMGUI_C89_FUNCTION_BEGIN font_render_char */
ImFontBaked *baked;
const ImFontGlyph *glyph;
ImVec2 p0;
ImVec2 p1;
ImVec2 uv0;
ImVec2 uv1;
float scale;
float x;
float y;
float x1;
float x2;
float y1;
float y2;
float u1;
float u2;
float v1;
float v2;

baked = @GET_BAKED@(imgui_c89_ctx, self, size, -1.0f);
glyph = @FIND_GLYPH@(imgui_c89_ctx, baked, c);
if (!glyph || !glyph->Visible)
    return;
if (glyph->Colored)
    col |= 0x00ffffffu;
scale = size >= 0.0f ? size / baked->Size : 1.0f;
x = pos->x;
y = pos->y;
if ((draw_list->Flags & @NO_PIXEL_SNAP@) == 0)
{
    x = (float)(int)x;
    y = (float)(int)y;
}

x1 = x + glyph->X0 * scale;
x2 = x + glyph->X1 * scale;
if (cpu_fine_clip && (x1 > cpu_fine_clip->z || x2 < cpu_fine_clip->x))
    return;
y1 = y + glyph->Y0 * scale;
y2 = y + glyph->Y1 * scale;
u1 = glyph->U0;
v1 = glyph->V0;
u2 = glyph->U1;
v2 = glyph->V1;

if (cpu_fine_clip)
{
    if (x1 < cpu_fine_clip->x)
    {
        u1 += (1.0f - (x2 - cpu_fine_clip->x) / (x2 - x1)) * (u2 - u1);
        x1 = cpu_fine_clip->x;
    }
    if (y1 < cpu_fine_clip->y)
    {
        v1 += (1.0f - (y2 - cpu_fine_clip->y) / (y2 - y1)) * (v2 - v1);
        y1 = cpu_fine_clip->y;
    }
    if (x2 > cpu_fine_clip->z)
    {
        u2 = u1 + (cpu_fine_clip->z - x1) / (x2 - x1) * (u2 - u1);
        x2 = cpu_fine_clip->z;
    }
    if (y2 > cpu_fine_clip->w)
    {
        v2 = v1 + (cpu_fine_clip->w - y1) / (y2 - y1) * (v2 - v1);
        y2 = cpu_fine_clip->w;
    }
    if (y1 >= y2)
        return;
}

p0.x = x1;
p0.y = y1;
p1.x = x2;
p1.y = y2;
uv0.x = u1;
uv0.y = v1;
uv1.x = u2;
uv1.y = v2;
@PRIM_RESERVE@(imgui_c89_ctx, draw_list, 6, 4);
@PRIM_RECT_UV@(draw_list, &p0, &p1, &uv0, &uv1, col);
/* IMGUI_C89_FUNCTION_END font_render_char */
